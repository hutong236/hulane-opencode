{
  "name": "@hulane/workbench",
  "version": "0.1.0-dev",
  "private": true,
  "description": "Local Web workbench for Hulane/OpenCode V2",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n api,web \"npm run dev -w @hulane/workbench-api\" \"npm run dev -w @hulane/workbench-web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "node scripts/lint.mjs"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "concurrently": "9.2.0",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  }
}
